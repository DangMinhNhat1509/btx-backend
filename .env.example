# Environment Configuration

# Application
NODE_ENV=development
PORT=3000

# API
API_PREFIX=api
API_VERSION=v1

# Database
# Chưa sử dụng ở bootstrap phase
DATABASE_URL=

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3001

# Redis
REDIS_URL=

# Storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=